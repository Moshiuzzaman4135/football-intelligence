FOOTBALL_DATA_ROOT=/app/data
FOOTBALL_DETECTOR=color
FOOTBALL_MODEL_NAME=yolo11n.pt
FOOTBALL_DEVICE=auto
FOOTBALL_MAX_FRAME_ERRORS=10
FOOTBALL_OBJECT_STORE_BACKEND=s3
FOOTBALL_POSTGRES_PASSWORD=replace-with-database-password
FOOTBALL_DATABASE_URL=postgresql+psycopg://football_app:replace-with-database-password@postgres/football
FOOTBALL_S3_ENDPOINT_URL=http://minio:9000
FOOTBALL_S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9010
FOOTBALL_MINIO_ROOT_USER=replace-with-minio-root-user
FOOTBALL_MINIO_ROOT_PASSWORD=replace-with-minio-root-password
FOOTBALL_S3_ACCESS_KEY=replace-with-bucket-app-access-key
FOOTBALL_S3_SECRET_KEY=replace-with-bucket-app-secret-key
FOOTBALL_S3_BUCKET=football-media
FOOTBALL_TESSDATA_DIR=/usr/share/tesseract-ocr/5/tessdata_fast
# Manual normalized scoreboard ROI: default top 20 percent of the frame.
FOOTBALL_SCOREBOARD_REGION_X=0
FOOTBALL_SCOREBOARD_REGION_Y=0
FOOTBALL_SCOREBOARD_REGION_WIDTH=1
FOOTBALL_SCOREBOARD_REGION_HEIGHT=0.2
FOOTBALL_API_URL=http://backend:8000
FOOTBALL_BACKEND_PORT=8010
FOOTBALL_UI_PORT=8510
FOOTBALL_MINIO_PORT=9010
FOOTBALL_MINIO_CONSOLE_PORT=9011
FOOTBALL_UID=1000
FOOTBALL_GID=1000
